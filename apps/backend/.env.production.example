NODE_ENV=production
PORT=3000
# JWT — set real secrets in the host environment (never commit production values).
JWT_SECRET=replace-with-at-least-32-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Production MUST set an explicit allowlist — wildcard is not safe for real deploys.
# Example:
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
AUTH_EMAIL_VERIFICATION_EXPIRES_IN=15m
AUTH_PASSWORD_RESET_EXPIRES_IN=1h

# --- Resend (SMTP) — https://resend.com/docs/send-with-nodemailer-smtp
# Set SMTP_PASS to your Resend API key in the host environment (e.g. platform secret, not this file).
# Verify your sending domain in Resend; set SMTP_FROM to an address on that domain.
# APP_PUBLIC_ORIGIN = your live app origin for password-reset links (https, no trailing slash).
APP_PUBLIC_ORIGIN=https://your-app.example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="App <auth@yourdomain.com>"
