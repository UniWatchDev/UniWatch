NODE_ENV=production
PORT=3000
# JWT — set real secrets in the host environment (never commit production values).
JWT_SECRET=replace-with-at-least-32-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Production MUST set an explicit allowlist — wildcard is not safe for real deploys.
# Example:
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
# Must be false in production — never expose verification codes in API JSON.
AUTH_DEBUG_EMAIL_TOKENS=false
AUTH_EMAIL_VERIFICATION_EXPIRES_IN=15m
AUTH_PASSWORD_RESET_EXPIRES_IN=1h
# Outbound mail (set SMTP_HOST + SMTP_PORT + SMTP_FROM in production).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_PUBLIC_ORIGIN=
