NODE_ENV=development
PORT=3000
# JWT — use a long random secret locally (≥32 chars). Examples are placeholders only.
JWT_SECRET=01234567890123456789012345678901
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Allowed CORS origins. `*` = allow all (dev default).
# For real deploys, set a comma-separated allowlist of exact origins:
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
# TTL for email verification 6-digit codes (e.g. 15m, 24h).
AUTH_EMAIL_VERIFICATION_EXPIRES_IN=15m
# TTL for opaque password-reset tokens (e.g. 1h, 24h).
AUTH_PASSWORD_RESET_EXPIRES_IN=1h

# --- Resend (SMTP) — local and production use the same host; see https://resend.com/docs/send-with-nodemailer-smtp
# - Host smtp.resend.com, port 465, user resend, password = API key (re_...).
# - Put `SMTP_PASS=re_...` only in `.env.development.local` (gitignored). Do not commit API keys.
# - FROM: use `onboarding@resend.dev` until your domain is verified in Resend, then e.g. `App <auth@yourdomain.com>`.
# - APP_PUBLIC_ORIGIN: base URL for password-reset links (no trailing slash), e.g. http://localhost:5173 (Vite) or http://localhost:5172 (web app).
APP_PUBLIC_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_FROM="UniWatch <onboarding@resend.dev>"