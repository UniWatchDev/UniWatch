# Copy to gitignored `.env.development` before `pnpm dev`:
#   cp env.development.template .env.development
# Then edit secrets (JWT) and Mongo URI if needed. Start Mongo locally or use Atlas.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Required — min 32 characters (see `env.validation.ts`)
JWT_SECRET=0123456789abcdef0123456789abcdef

# Required — `mongodb://` or `mongodb+srv://` (validated at startup)
MONGODB_URI=mongodb://127.0.0.1:27017/uniwatch

# Optional JWT TTLs (defaults match schema)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Set `true` only when wiring Resend SMTP (see `apps/backend/AGENTS.md`)
AUTH_USE_REAL_EMAILS=false

# Optional auth TTLs
# AUTH_EMAIL_VERIFICATION_EXPIRES_IN=15m
# AUTH_PASSWORD_RESET_EXPIRES_IN=1h

# Optional SMTP (required when AUTH_USE_REAL_EMAILS=true)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional auth observability (high-level debug lines only; never secrets)
# AUTH_DEBUG_LOG=true

# Rate limits for POST /api/auth/* (and similar); see `ThrottlerModule` in `app.module.ts`
# AUTH_THROTTLE_TTL_MS=60000
# AUTH_THROTTLE_LIMIT=60

# Movie files: Cloudflare R2 (S3-compatible). Defaults to in-memory unless STORAGE_DRIVER=s3.
# S3_ENDPOINT must use your Cloudflare **Account ID** (R2 → Overview), NOT the API token access key.
# EU jurisdiction: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# Default: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_DRIVER=s3
S3_REGION=auto
S3_BUCKET=uniwatch-dev
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Movie upload limits
# MOVIE_UPLOAD_MAX_BYTES=1073741824
# MOVIE_ALLOWED_MIMES=video/mp4,video/quicktime
# MOVIE_FILE_TTL_HOURS=24
# MOVIE_STREAM_URL_EXPIRES_SECONDS=900
