# Copy to gitignored `.env.development` before `pnpm dev`:
#   cp env.development.template .env.development
# Then edit secrets (JWT) and Mongo URI if needed. Start Mongo locally or use Atlas.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Required — min 32 characters (see `env.validation.ts`)
JWT_SECRET=0123456789abcdef0123456789abcdef

# Required — `mongodb://` or `mongodb+srv://` (validated at startup)
MONGODB_URI=mongodb://127.0.0.1:27017/uniwatch

# Optional JWT TTLs (defaults match schema)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Set `true` only when wiring Resend SMTP (see `apps/backend/AGENTS.md`)
AUTH_USE_REAL_EMAILS=false

# Optional auth TTLs
# AUTH_EMAIL_VERIFICATION_EXPIRES_IN=15m
# AUTH_PASSWORD_RESET_EXPIRES_IN=1h

# Optional SMTP (required when AUTH_USE_REAL_EMAILS=true)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional base URL for password-reset links in email
# APP_PUBLIC_ORIGIN=
