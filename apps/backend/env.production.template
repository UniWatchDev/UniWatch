# Copy to gitignored `.env.production` for local prod rehearsal / deployment secrets.
# Never commit the real file.

NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-app.example.com
# With HttpOnly cookies, browsers require an explicit allowlist — never `*` in production.

# Generate a strong secret (≥32 chars)
JWT_SECRET=replace-with-production-secret-at-least-32-chars

# Production Mongo (Atlas or managed URI)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/your-db?retryWrites=true&w=majority

# Real email in production defaults to on unless explicitly set false
# AUTH_USE_REAL_EMAILS=true

# When AUTH_USE_REAL_EMAILS=true, set Resend SMTP (see `apps/backend/AGENTS.md`)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM="App <onboarding@resend.dev>"

# APP_PUBLIC_ORIGIN=https://your-app.example.com

# Optional: auth route rate limits (defaults in `env.validation.ts`)
# AUTH_THROTTLE_TTL_MS=60000
# AUTH_THROTTLE_LIMIT=60

# Comma-separated emails granted admin access (catalog publishing). Synced to users.isAdmin on startup.
ADMIN_EMAILS=danielsaggir@gmail.com

# Optional: high-level auth flow debug logs (never secrets)
# AUTH_DEBUG_LOG=false

# Movie files: Cloudflare R2 (S3-compatible). Production uses STORAGE_DRIVER=s3 by default.
# Create an R2 API token scoped to bucket `uniwatch-production`.
S3_REGION=auto
S3_BUCKET=uniwatch-production
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Optional movie limits (defaults in `env.validation.ts`)
# MOVIE_UPLOAD_MAX_BYTES=1073741824
# MOVIE_ALLOWED_MIMES=video/mp4,video/quicktime
# MOVIE_FILE_TTL_HOURS=24
# MOVIE_STREAM_URL_EXPIRES_SECONDS=900
