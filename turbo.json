{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "JWT_SECRET",
    "JWT_ACCESS_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "CORS_ORIGIN",
    "AUTH_EMAIL_VERIFICATION_EXPIRES_IN",
    "AUTH_PASSWORD_RESET_EXPIRES_IN",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "AUTH_USE_REAL_EMAILS",
    "AUTH_DEBUG_LOG",
    "AUTH_THROTTLE_TTL_MS",
    "AUTH_THROTTLE_LIMIT",
    "APP_PUBLIC_ORIGIN",
    "MONGODB_URI",
    "STORAGE_DRIVER",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "MOVIE_UPLOAD_MAX_BYTES",
    "MOVIE_ALLOWED_MIMES",
    "MOVIE_FILE_TTL_HOURS",
    "MOVIE_STREAM_URL_EXPIRES_SECONDS",
    "NEXT_PUBLIC_*",
    "VITE_*"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development",
        ".env.production"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development",
        ".env.production"
      ]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development",
        ".env.production"
      ]
    },
    "start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development",
        ".env.production"
      ]
    }
  }
}
